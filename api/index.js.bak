// --- USER PROFILE ---
app.put('/api/user/profile', authenticateUser, async (req, res) => {
  try {
    await connectDB();
    const user = await User.findById(req.user.id);
    if (!user) return res.status(404).json({ error: 'User not found' });

    const { otp, profileData } = req.body;
    
    // Verify OTP
    if (!otp) return res.status(400).json({ error: 'OTP is required.' });
    const storedOtpData = otpStore.get(user.email);
    if (!storedOtpData || storedOtpData.otp !== otp || Date.now() > storedOtpData.expires) {
      return res.status(400).json({ error: 'Invalid or expired OTP.' });
    }

    // Update fields
    const allowedFields = ['fullName', 'city', 'country', 'nativeLanguage', 'additionalLanguage', 'phone', 'experience', 'howFoundUs', 'upiId'];
    for (const field of allowedFields) {
      if (profileData[field] !== undefined) {
        user[field] = profileData[field];
      }
    }
    
    await user.save();
    otpStore.delete(user.email); // Clear OTP
    
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Failed to update profile' });
  }
});

app.put('/api/user/password', authenticateUser, async (req, res) => {
  try {
    await connectDB();
    const { oldPassword, newPassword } = req.body;
    
    if (!oldPassword || !newPassword) {
      return res.status(400).json({ error: 'Old password and new password are required.' });
    }

    const user = await User.findById(req.user.id);
    if (!user) return res.status(404).json({ error: 'User not found' });

    const isMatch = await bcrypt.compare(oldPassword, user.password);
    if (!isMatch) {
      return res.status(400).json({ error: 'Incorrect old password.' });
    }

    const hashedPassword = await bcrypt.hash(newPassword, 10);
    user.password = hashedPassword;
    await user.save();
    
    res.json({ success: true, message: 'Password changed successfully.' });
  } catch (err) {
    res.status(500).json({ error: 'Failed to change password' });
  }
});

// --- APPLICATIONS ---
app.post('/api/applications', authenticateUser, async (req, res) => {
  try {
    await connectDB();
    const { projectId, agreedToTerms, formData } = req.body;
    const existing = await Application.findOne({ projectId, contributorId: req.user.id });
    if (existing) return res.status(400).json({ error: 'Already applied' });

    const project = await Project.findById(projectId);
    if (!project) return res.status(404).json({ error: 'Project not found' });

    if (project.termsAndConditions) {
      if (!agreedToTerms) {
        return res.status(400).json({ error: 'You must agree to the Terms and Conditions to apply.' });
      }
      const consent = new Consent({
        projectId,
        contributorId: req.user.id,
        termsSnapshot: project.termsAndConditions
      });
      await consent.save();
    }

    const app = new Application({ projectId, contributorId: req.user.id, status: 'Applied', formData });
    await app.save();
    res.status(201).json({ success: true, application: app });
  } catch (err) {
    res.status(500).json({ error: 'Failed to apply' });
  }
});

